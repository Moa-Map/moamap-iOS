// Secrets.xcconfig 로 복사한 뒤 값을 채운다.
//
//     cp Configs/Secrets.xcconfig.example Configs/Secrets.xcconfig

// 서버 기본값은 Base.xcconfig에 정의돼 있다. 필요한 환경만 주석을 풀어 재정의한다.
// DEBUG_BASE_URL = https:$(SLASH)$(SLASH)api-dev.moamap.co.kr/
// RELEASE_BASE_URL = https:$(SLASH)$(SLASH)api.moamap.co.kr/

// 카카오 네이티브 앱 키. 로그인과 URL Scheme(kakao{키}) 에 쓴다.
KAKAO_NATIVE_APP_KEY =

// 카카오 REST API 키. 장소 검색용.
KAKAO_REST_API_KEY =

// 구글 iOS OAuth 클라이언트 ID 와 iOS URL scheme. 구글 클라우드 콘솔 클라이언트 화면에 있다.
// 예) 1234-abcd.apps.googleusercontent.com / com.googleusercontent.apps.1234-abcd
GOOGLE_CLIENT_ID =
GOOGLE_URL_SCHEME =

// Mapbox 공개 토큰(pk.). 내려받기용 시크릿 토큰(sk.)은 ~/.netrc 에 둔다.
MAPBOX_PUBLIC_TOKEN =
